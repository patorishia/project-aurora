generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Store {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  logo             String?
  website          String?
  awinAdvertiserId Int?     @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  coupons Coupon[]

  @@index([name])
}

model Coupon {
  id          String    @id @default(cuid())
  storeId     String
  title       String
  description String?
  code        String?
  discount    String?
  url         String
  trackingUrl String?
  startsAt    DateTime?
  expiresAt   DateTime?
  active      Boolean   @default(true)
  verified    Boolean   @default(false)
  source      String?
  sourceId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([source, sourceId])
  @@index([storeId])
  @@index([active])
  @@index([expiresAt])
}